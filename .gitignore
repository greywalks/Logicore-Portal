# Auto-generated Flask session-cookie signing key, shared by the portal app
# and the mounted Training Tracker app (see portal_auth.py). Anyone with this
# file can forge session cookies for every app instance — never commit it or
# ship it in a handoff zip. Created automatically on first run if missing.
.flask_secret

# Shared users/permissions database (see portal_auth.py) — runtime data,
# not source. Created automatically (with a seeded admin/admin superadmin)
# on first run.
portal_auth.db

# Runtime data — user uploads, generated invoices, editable pricing/config
# that shouldn't be baked into version control.
/uploads/*
!/uploads/.gitkeep
/outputs/*
!/outputs/.gitkeep
storage_prices.json
amc_prices.json
philips_dimensions.json
philips_repair_cost.json
amc_dimensions.json

# Training Tracker — its own runtime data (separate SQLite DB + session
# secret, both auto-created next to training_tracker/app.py on first run)
# and uploaded physical sign-off sheet scans.
training_tracker/.secret_key
training_tracker/training_planner.db
training_tracker/training_planner.db-*
/training_tracker/signoff_uploads/*
!/training_tracker/signoff_uploads/.gitkeep

# Inventory Management — runtime DB and retained source uploads. In production
# set INVENTORY_DATA_DIR to the mounted Render persistent-disk path so these
# survive deploys without ever being committed to the repository.
/inventory_management/data/*
!/inventory_management/data/.gitkeep
inventory_management/*.db
inventory_management/*.db-*

# Dev-only Tailwind build tooling
build/node_modules/

# Python
__pycache__/
*.pyc
.pytest_cache/
