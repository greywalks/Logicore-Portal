From 9aee0058460e4fcfc26ade37a6a0600af79bc885 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Thu, 13 Aug 2026 14:28:27 +0000
Subject: [PATCH] Fix: Users & Permissions page was missing the shared portal
 sidebar

admin_permissions.html was a fully standalone page (no sidebar, no light/
dark toggle) instead of reusing the shared portal shell. It now renders the
same sidebar/topbar as index.html (nav items still gated by the viewing
user's own permissions), using the lightweight sidebar-nav.js subset of
app.js that training_tracker/base.html already relies on for the same
reason (the full app.js assumes Invoice Generator form elements exist on
the page and throws otherwise).

Also extracted a shared _nav_context(user) helper in app.py so index() and
admin_permissions() (and any future portal page) compute the same
sidebar-visibility flags from one place instead of duplicating the logic.
---
 app.py                           |  37 +++++----
 templates/admin_permissions.html | 133 ++++++++++++++++++++++++++-----
 2 files changed, 136 insertions(+), 34 deletions(-)

diff --git a/app.py b/app.py
index 4ac2f6a..3cd6f23 100644
--- a/app.py
+++ b/app.py
@@ -193,6 +193,7 @@ def admin_permissions():
         users=users,
         perms_by_user=perms_by_user,
         sections=portal_auth.SECTIONS,
+        **_nav_context(user),
     )
 
 
@@ -712,9 +713,10 @@ def healthz():
     """Render (and similar hosts) hit this to confirm the service is alive."""
     return jsonify({"ok": True}), 200
 
-@app.route("/")
-def index():
-    user = portal_auth.get_current_user()
+def _nav_context(user):
+    """Shared sidebar/permission context — used by index() and any other
+    portal page that renders the sidebar shell (currently also
+    admin_permissions()), so they stay in sync automatically."""
     ig_children = set(portal_auth.accessible_children(user, "invoice-generator"))
     can_ig = bool(ig_children)
     can_sms = portal_auth.has_access(user, "sms-nonconforming")
@@ -735,18 +737,23 @@ def index():
                 default_client = c
                 break
 
-    return render_template(
-        "index.html",
-        auth_user=user,
-        can_invoice_generator=can_ig,
-        ig_children=ig_children,
-        can_sms_nonconforming=can_sms,
-        can_tbd2=can_tbd2,
-        can_training_tracker=can_tt,
-        default_portal=default_portal,
-        default_client=default_client,
-        has_any_access=bool(default_portal or can_tt),
-    )
+    return {
+        "auth_user": user,
+        "can_invoice_generator": can_ig,
+        "ig_children": ig_children,
+        "can_sms_nonconforming": can_sms,
+        "can_tbd2": can_tbd2,
+        "can_training_tracker": can_tt,
+        "default_portal": default_portal,
+        "default_client": default_client,
+        "has_any_access": bool(default_portal or can_tt),
+    }
+
+
+@app.route("/")
+def index():
+    user = portal_auth.get_current_user()
+    return render_template("index.html", **_nav_context(user))
 
 
