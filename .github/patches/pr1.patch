+
+    assert depot.empty
+    assert triage.empty
+    assert len(excluded) == 1
+    assert excluded.iloc[0]["Serial"] == "DUP-1"
+    assert excluded.iloc[0]["Source Tab"] == "Depot Repair"
+    assert "no later shipment" in excluded.iloc[0]["Reason"]
