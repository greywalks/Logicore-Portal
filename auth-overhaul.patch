-    <p class="font-mono text-[11px] text-ink-faint uppercase tracking-wide mb-4">{{ c('sign.dialog_subheading') }}</p>
-
-    <div class="bg-parchment-dim border border-parchment-line rounded-md ruled-line">
-      <canvas id="sigCanvas" width="440" height="180" class="w-full touch-none cursor-crosshair"></canvas>
-    </div>
-
-    <div class="flex justify-between items-center mt-3 mb-6">
-      <button type="button" onclick="clearCanvas()" class="font-mono text-xs uppercase tracking-wide text-ink-faint hover:text-rose">{{ c('sign.clear_btn') }}</button>
-      <p class="font-mono text-[11px] text-ink-faint">{{ today }}</p>
-    </div>
-
-    <form id="signForm" method="POST">
-      <input type="hidden" name="signature" id="signatureData">
-      <div class="flex justify-end gap-3">
-        <button type="button" onclick="signDialog.close()" class="font-mono text-sm uppercase tracking-wide text-ink-faint px-4 py-2 hover:text-ink">{{ c('sign.cancel_btn') }}</button>
-        <button type="button" onclick="submitSignature()" class="bg-amber hover:bg-amber-dark text-ink font-semibold font-mono text-sm uppercase tracking-wide px-5 py-2 rounded-md">{{ c('sign.confirm_btn') }}</button>
-      </div>
-    </form>
-  </div>
-</dialog>
-
-<script>
-const canvas = document.getElementById('sigCanvas');
-const ctx = canvas.getContext('2d');
-ctx.lineWidth = 2.4;
-ctx.lineCap = 'round';
-// Read the live --tt-ink CSS var (not the server-rendered {{ theme.ink.DEFAULT }})
-// so the pen color still contrasts against the canvas after a light/dark toggle —
-// ink is a light color in dark mode and a dark color in light mode.
-function applyInkColor() {
-  ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--tt-ink').trim();
-}
-applyInkColor();
-let drawing = false;
-let hasDrawn = false;
-
-function getPos(e) {
-  const rect = canvas.getBoundingClientRect();
-  const scaleX = canvas.width / rect.width;
-  const scaleY = canvas.height / rect.height;
-  const point = e.touches ? e.touches[0] : e;
-  return { x: (point.clientX - rect.left) * scaleX, y: (point.clientY - rect.top) * scaleY };
-}
-
-function startDraw(e) {
-  drawing = true;
-  hasDrawn = true;
-  const p = getPos(e);
-  ctx.beginPath();
-  ctx.moveTo(p.x, p.y);
-  e.preventDefault();
-}
-function draw(e) {
-  if (!drawing) return;
-  const p = getPos(e);
-  ctx.lineTo(p.x, p.y);
-  ctx.stroke();
-  e.preventDefault();
-}
-function stopDraw() { drawing = false; }
-
-canvas.addEventListener('mousedown', startDraw);
-canvas.addEventListener('mousemove', draw);
-canvas.addEventListener('mouseup', stopDraw);
-canvas.addEventListener('mouseleave', stopDraw);
-canvas.addEventListener('touchstart', startDraw);
-canvas.addEventListener('touchmove', draw);
-canvas.addEventListener('touchend', stopDraw);
-
-function clearCanvas() {
-  ctx.clearRect(0, 0, canvas.width, canvas.height);
-  hasDrawn = false;
-}
-
-function openSignDialog(personId, name) {
-  clearCanvas();
-  applyInkColor();
-  document.getElementById('signName').textContent = name;
-  document.getElementById('signForm').action = `/session/{{ session.id }}/sign/${personId}`;
-  signDialog.showModal();
-}
-
-function submitSignature() {
-  if (!hasDrawn) {
-    alert('Please draw a signature first.');
-    return;
-  }
-  document.getElementById('signatureData').value = canvas.toDataURL('image/png');
-  document.getElementById('signForm').submit();
-}
-</script>
-{% endblock %}
